# Use the same Firebase project and Firestore database as firebase-applet-config.json.
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_DATABASE_ID=YOUR_FIRESTORE_DATABASE_ID
FIREBASE_VAPID_PUBLIC_KEY=YOUR_PUBLIC_VAPID_KEY

# Prefer a service-account JSON file stored outside public_html.
GOOGLE_APPLICATION_CREDENTIALS=/home/CPANEL_USERNAME/private/whatapp-firebase-admin.json

# Comma-separated allowed origins for the web app.
ALLOWED_ORIGINS=https://whatapp.my.id,http://localhost:5173
